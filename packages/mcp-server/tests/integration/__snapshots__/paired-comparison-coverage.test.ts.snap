exports[`exclude responses stay byte-identical unobservedDays exclude, grid xnys 1`] = `"{"summary":"Paired comparison: the difference in mean daily P&L (A minus B) is $5.01, 95% CI [-$19.83, $31.70] -- includes zero (not distinguishable).","data":{"comparison":{"strategyA":"A","strategyB":"B","mode":"two-arm","description":"A minus B"},"statistic":"mean_daily_pnl","point":5.009344753102753,"ci":{"level":0.95,"low":-19.834148972415644,"high":31.70456296218366,"method":"paired-day-block"},"status":"resolved","refusal":null,"effectiveN":87,"blockDays":1,"blockDaysDerivation":"block length = 1 trading day(s), derived from the 95th-percentile holding period of arm A (the longer-held arm -- the conservative choice)","overlapWindow":{"start":"2023-01-06","end":"2024-12-30"},"observedDays":{"armA":261,"armB":261},"tradeCounts":{"armA":261,"armB":261},"sensitivity":[{"blockDays":1,"ci":{"low":-19.834148972415644,"high":31.70456296218366},"status":"resolved"},{"blockDays":2,"ci":{"low":null,"high":null},"status":"underpowered"}],"resamples":1000,"seed":42,"ciLevel":0.95,"attributionMethodology":"A trade's P&L is attributed evenly across the trading days it was open (dateOpened through dateClosed). Trading days follow the XNYS session calendar (every NYSE session from the compared strategies' first to their last trade date), plus any trade open or close date that is not a session.","unobservedDays":"exclude","grid":"xnys","dayGridMethodology":"Grid: the XNYS session calendar (every NYSE session from the compared strategies' first to last trade date), plus trade dates. Days without a position are not observed; only days both arms hold are compared."}}"`;
